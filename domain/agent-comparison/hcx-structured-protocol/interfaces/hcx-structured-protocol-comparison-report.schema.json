{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://disclosure-analyst.local/schema/hcx-structured-protocol/comparison-report.v0.1.json",
  "title": "HCX Structured Output Protocol Comparison Report v0.1",
  "description": "Turn P11-D: the aggregate, secret-free report comparing HCX-005 Native v3 Function Calling against OpenAI-compatible response_format=json_schema. Never contains raw prompt/response/tool-argument text, an API key, or an Authorization header value (see artifacts.mjs's buildSecurityAttestation).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "created_at", "ready", "stopped_early_reason", "total_requests_attempted", "candidates", "selection", "security_attestation"],
  "properties": {
    "schema_version": { "type": "string" },
    "run_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "ready": { "type": "boolean" },
    "stopped_early_reason": { "anyOf": [{ "type": "string", "enum": ["MISSING_CREDENTIALS", "AUTH_ERROR", "GLOBAL_HARD_CAP_REACHED"] }, { "type": "null" }] },
    "total_requests_attempted": { "type": "integer", "minimum": 0 },
    "candidates": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["FUNCTION_CALLING", "RESPONSE_FORMAT"],
          "properties": {
            "FUNCTION_CALLING": { "$ref": "#/$defs/candidateSummary" },
            "RESPONSE_FORMAT": { "$ref": "#/$defs/candidateSummary" }
          }
        }
      ]
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected_candidate", "status", "reason"],
      "properties": {
        "selected_candidate": { "anyOf": [{ "type": "string", "enum": ["FUNCTION_CALLING", "RESPONSE_FORMAT"] }, { "type": "null" }] },
        "status": { "type": "string", "enum": ["GREEN_SELECTED", "RED_NO_SELECTION"] },
        "reason": { "type": "string" }
      }
    },
    "security_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks", "overall_status"],
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check_name", "passed", "detail"],
            "properties": {
              "check_name": { "type": "string" },
              "passed": { "type": "boolean" },
              "detail": { "type": "string" }
            }
          }
        },
        "overall_status": { "type": "string", "enum": ["PASS", "FAIL"] }
      }
    }
  },
  "$defs": {
    "candidateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id", "construction_error", "requests_attempted", "requests_succeeded", "requests_failed",
        "retries_performed", "per_scenario", "schema_violation_count", "tool_envelope_violation_count",
        "malformed_count", "unsupported_count", "citation_violation_count", "latency_ms", "token_usage_aggregate", "green"
      ],
      "properties": {
        "candidate_id": { "type": "string", "enum": ["FUNCTION_CALLING", "RESPONSE_FORMAT"] },
        "construction_error": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "name"],
              "properties": { "code": { "anyOf": [{ "type": "string" }, { "type": "null" }] }, "name": { "type": "string" } }
            }
          ]
        },
        "requests_attempted": { "type": "integer", "minimum": 0 },
        "requests_succeeded": { "type": "integer", "minimum": 0 },
        "requests_failed": { "type": "integer", "minimum": 0 },
        "retries_performed": { "type": "integer", "minimum": 0 },
        "per_scenario": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scenario_type", "repetitions_observed", "successes", "success_rate"],
            "properties": {
              "scenario_type": { "type": "string" },
              "repetitions_observed": { "type": "integer", "minimum": 0 },
              "successes": { "type": "integer", "minimum": 0 },
              "success_rate": { "anyOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "null" }] }
            }
          }
        },
        "schema_violation_count": { "type": "integer", "minimum": 0 },
        "tool_envelope_violation_count": { "type": "integer", "minimum": 0 },
        "malformed_count": { "type": "integer", "minimum": 0 },
        "unsupported_count": { "type": "integer", "minimum": 0 },
        "citation_violation_count": { "type": "integer", "minimum": 0 },
        "latency_ms": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["p50_ms", "p95_ms", "max_ms", "count"],
              "properties": {
                "p50_ms": { "type": "number" }, "p95_ms": { "type": "number" }, "max_ms": { "type": "number" }, "count": { "type": "integer", "minimum": 0 }
              }
            }
          ]
        },
        "token_usage_aggregate": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["input_tokens_total", "output_tokens_total"],
              "properties": { "input_tokens_total": { "type": "number", "minimum": 0 }, "output_tokens_total": { "type": "number", "minimum": 0 } }
            }
          ]
        },
        "green": { "type": "boolean" }
      }
    }
  }
}
