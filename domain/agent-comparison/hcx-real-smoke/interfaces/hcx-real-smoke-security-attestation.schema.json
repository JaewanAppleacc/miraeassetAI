{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://disclosure-analyst.local/schema/agent-comparison/hcx-real-smoke-security-attestation.v0.1.json",
  "title": "HCX Real Smoke Security Attestation v0.1",
  "description": "Turn P11-B: automated, evidence-backed attestation that no secret (API key value, Authorization header, raw provider response body) leaked into any artifact this run produced. Built by scanning the OTHER three artifacts' serialized JSON text for the exact secret value and for header/body-shaped content -- never itself contains the secret value being checked for.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "created_at", "api_key_env_var_name", "checks", "overall_status"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "api_key_env_var_name": { "type": "string", "minLength": 1 },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_name", "passed", "detail"],
        "properties": {
          "check_name": { "type": "string", "minLength": 1 },
          "passed": { "type": "boolean" },
          "detail": { "type": "string" }
        }
      }
    },
    "overall_status": { "enum": ["PASS", "FAIL"] }
  }
}
