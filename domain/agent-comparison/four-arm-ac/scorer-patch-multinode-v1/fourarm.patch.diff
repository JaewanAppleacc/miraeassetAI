+_EMPTY_ROW_RE = re.compile(r"^[\s|]*$")
+

+def _table_aware_norm(s: str) -> str:
+    s = unicodedata.normalize("NFC", s or "")
+    kept_lines = [ln for ln in s.split("\n") if not _EMPTY_ROW_RE.match(ln)]
+    return "".join("\n".join(kept_lines).split())

