{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://disclosure-analyst.local/schema/chunk.v0.1.json",
  "title": "Disclosure Analyst common Chunk v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "corpus_snapshot_id", "source_document_ir",
    "chunking_config_id", "strategy_name", "strategy_version", "chunk_id",
    "document_id", "chunk_index", "chunk_type", "parent_chunk_id",
    "raw_text", "embed_text", "tokenizer", "token_count", "embed_token_count",
    "source_node_ids", "source_section_ids", "section_path", "source_locator",
    "source_spans", "content_sha256", "duplicate_group_id", "repeated_section",
    "metadata"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "corpus_snapshot_id": { "type": "string", "minLength": 1 },
    "source_document_ir": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_corpus_snapshot_id", "parser_version", "schema_version",
        "parser_code_revision", "parser_config_hash"
      ],
      "properties": {
        "source_corpus_snapshot_id": { "type": "string", "minLength": 1 },
        "parser_version": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "minLength": 1 },
        "parser_code_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "parser_config_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "chunking_config_id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+$" },
    "strategy_name": {
      "enum": ["fixed-token", "section-aware-flat", "document-type-hierarchical-parent-child"]
    },
    "strategy_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "chunk_id": { "type": "string", "pattern": "^chunk_[0-9a-f]{24}$" },
    "document_id": {
      "type": "string",
      "pattern": "^(periodic|major|exchange|holding)_[0-9]{14}$"
    },
    "chunk_index": { "type": "integer", "minimum": 0 },
    "chunk_type": {
      "enum": [
        "FIXED_WINDOW", "SECTION_FLAT", "SECTION_PARENT", "EVENT_PARENT",
        "HOLDING_STATUS_PARENT", "PARAGRAPH_CHILD", "FIELD_GROUP_CHILD",
        "TABLE_WHOLE", "TABLE_ROW", "DOCUMENT_FALLBACK"
      ]
    },
    "parent_chunk_id": { "type": ["string", "null"], "pattern": "^chunk_[0-9a-f]{24}$" },
    "raw_text": { "type": "string", "minLength": 1 },
    "embed_text": { "type": "string", "minLength": 1 },
    "tokenizer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "unicode-word-punct" },
        "version": { "const": "1.0.0" }
      }
    },
    "token_count": { "type": "integer", "minimum": 1 },
    "embed_token_count": { "type": "integer", "minimum": 1 },
    "source_node_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "source_section_ids": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "section_path": {
      "type": "array",
      "items": { "type": "string" }
    },
    "source_locator": { "type": "string", "minLength": 1 },
    "source_spans": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/sourceSpan" }
    },
    "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "duplicate_group_id": { "type": ["string", "null"] },
    "repeated_section": { "type": "boolean" },
    "metadata": {
      "type": "object",
      "required": [
        "corp_code", "doc_group", "doc_subtype", "receipt_date", "is_correction",
        "source_parse_tier", "retrieval_eligible", "fact_eligible"
      ],
      "additionalProperties": true,
      "properties": {
        "corp_code": { "type": "string", "pattern": "^[0-9]{8}$" },
        "doc_group": { "enum": ["periodic", "major", "exchange", "holding"] },
        "doc_subtype": { "type": ["string", "null"] },
        "receipt_date": { "type": "string", "format": "date" },
        "is_correction": { "type": "boolean" },
        "source_parse_tier": { "enum": ["structured", "partial", "fallback"] },
        "retrieval_eligible": { "type": "boolean" },
        "fact_eligible": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "sourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_id", "rel_path", "node_id", "order_index",
        "row_start", "row_end", "col_start", "col_end", "source_locator"
      ],
      "properties": {
        "file_id": { "type": "string", "pattern": "^file_[0-9a-f]{24}$" },
        "rel_path": { "type": "string", "minLength": 1 },
        "node_id": { "type": "string", "minLength": 1 },
        "order_index": { "type": "integer", "minimum": 0 },
        "row_start": { "type": ["integer", "null"], "minimum": 0 },
        "row_end": { "type": ["integer", "null"], "minimum": 0 },
        "col_start": { "type": ["integer", "null"], "minimum": 0 },
        "col_end": { "type": ["integer", "null"], "minimum": 0 },
        "source_locator": { "type": "string", "minLength": 1 }
      }
    }
  }
}
