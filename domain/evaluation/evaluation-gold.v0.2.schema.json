{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://disclosure-analyst.local/schema/evaluation-gold.v0.2.json",
  "title": "Disclosure Analyst Evaluation Gold v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "question_id", "evaluation_group_id", "split", "question",
    "question_type", "difficulty", "answer_mode", "doc_groups", "corp_codes",
    "as_of_date", "expected_answerability", "gold_document_ids", "expected_fact_ids",
    "expected_event_ids", "required_evidence_slots", "expected_answer",
    "authored_against", "expected_execution", "scoring_spec", "tags"
  ],
  "properties": {
    "schema_version": { "const": "0.2.0" },
    "question_id": { "type": "string", "minLength": 1 },
    "evaluation_group_id": { "type": "string", "minLength": 1 },
    "split": { "enum": ["DEV_TUNE", "DEV_CHECK", "HOLDOUT"] },
    "question": { "type": "string", "minLength": 1 },
    "question_type": {
      "enum": [
        "SIMPLE_LOOKUP", "NUMERIC_LOOKUP", "COMPARISON_CALC", "EVENT_TRACE",
        "NARRATIVE_MULTI_DOC", "ANSWERABILITY", "POLICY_SAFETY"
      ]
    },
    "difficulty": { "enum": ["EASY", "MEDIUM", "HARD"] },
    "answer_mode": { "enum": ["CLOSED", "OPEN"] },
    "doc_groups": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["periodic", "major", "exchange", "holding"] }
    },
    "corp_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[0-9]{8}$" }
    },
    "as_of_date": { "type": ["string", "null"], "format": "date" },
    "expected_answerability": {
      "enum": [
        "SUPPORTED", "NOT_FOUND", "WITHHELD", "NOT_APPLICABLE", "UNANSWERABLE",
        "OUT_OF_SCOPE", "AMBIGUOUS_QUERY", "CONFLICTING_EVIDENCE"
      ]
    },
    "gold_document_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/documentId" }
    },
    "gold_chain_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^chain_[0-9a-f]{24}$" }
    },
    "expected_fact_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "expected_event_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "required_evidence_slots": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceSlot" }
    },
    "expected_answer": { "$ref": "#/$defs/expectedAnswer" },
    "authored_against": { "$ref": "#/$defs/authoredAgainst" },
    "expected_execution": { "$ref": "#/$defs/expectedExecution" },
    "scoring_spec": { "$ref": "#/$defs/scoringSpec" },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "documentId": {
      "type": "string",
      "pattern": "^(periodic|major|exchange|holding)_[0-9]{14}$"
    },
    "evidenceSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot_name", "description", "acceptable_sources"],
      "properties": {
        "slot_name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "acceptable_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["document_id", "source_locator", "evidence_span"],
            "properties": {
              "document_id": { "$ref": "#/$defs/documentId" },
              "source_locator": { "type": "string", "minLength": 1 },
              "evidence_span": { "type": "string", "minLength": 1 }
            }
          }
        },
        "expected_fact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "expected_event_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      }
    },
    "expectedAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value", "unit", "reason_code"],
      "properties": {
        "status": {
          "enum": [
            "SUPPORTED", "NOT_FOUND", "WITHHELD", "NOT_APPLICABLE", "UNANSWERABLE",
            "OUT_OF_SCOPE", "AMBIGUOUS_QUERY", "CONFLICTING_EVIDENCE"
          ]
        },
        "value": {},
        "unit": { "type": ["string", "null"] },
        "reason_code": { "type": ["string", "null"] }
      }
    },
    "authoredAgainst": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corpus_snapshot_id", "manifest_sha256", "parser_name", "parser_version",
        "document_ir_schema_version", "semantic_bundle_schema_version", "gold_revision"
      ],
      "properties": {
        "corpus_snapshot_id": { "type": "string", "minLength": 1 },
        "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "parser_name": { "type": "string", "minLength": 1 },
        "parser_version": { "type": "string", "minLength": 1 },
        "document_ir_schema_version": { "type": "string", "minLength": 1 },
        "semantic_bundle_schema_version": { "const": "0.2.0" },
        "gold_revision": { "type": "string", "minLength": 1 }
      }
    },
    "expectedExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicable_fact_coverage_states", "required_fact_slots",
        "required_fact_slots_sha256", "required_fact_slots_lock_status", "route_policy"
      ],
      "properties": {
        "applicable_fact_coverage_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/factCoverageState" }
        },
        "required_fact_slots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slot_name", "metric_code"],
            "properties": {
              "slot_name": { "type": "string", "minLength": 1 },
              "metric_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
              "period_key": { "type": ["string", "null"] },
              "scope": { "enum": ["CONSOLIDATED", "SEPARATE", "COMPANY", "SUBSIDIARY", "UNKNOWN", null] }
            }
          }
        },
        "required_fact_slots_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "required_fact_slots_lock_status": { "const": "GOLD_LOCKED" },
        "route_policy": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/routeRule" }
        }
      }
    },
    "factCoverageState": {
      "enum": [
        "ALL_REQUIRED_FACT_SLOTS_VERIFIED", "FACT_SLOT_VERIFIED_WITHHELD",
        "FACT_SLOT_VERIFIED_NOT_APPLICABLE", "PARTIAL_STRUCTURED_FACT_COVERAGE",
        "NO_STRUCTURED_FACT_COVERAGE", "ZERO_DOCUMENT_IN_CORPUS", "PARSE_BLOCKED",
        "OUT_OF_SCOPE", "CONFLICTING_VERIFIED_FACTS"
      ]
    },
    "routeRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "when", "preferred_route", "allowed_routes", "required_operations",
        "forbidden_operations", "expected_answerability"
      ],
      "properties": {
        "when": { "$ref": "#/$defs/factCoverageState" },
        "preferred_route": { "enum": ["STRUCTURED", "RETRIEVAL", "BOTH", "EARLY_EXIT"] },
        "allowed_routes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["STRUCTURED", "RETRIEVAL", "BOTH", "EARLY_EXIT"] }
        },
        "required_operations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "forbidden_operations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "expected_answerability": {
          "enum": [
            "SUPPORTED", "NOT_FOUND", "WITHHELD", "NOT_APPLICABLE", "UNANSWERABLE",
            "OUT_OF_SCOPE", "AMBIGUOUS_QUERY", "CONFLICTING_EVIDENCE"
          ]
        }
      }
    },
    "scoringSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparator", "tolerance", "unit", "rounding"],
      "properties": {
        "comparator": { "enum": ["EXACT", "ABSOLUTE", "RELATIVE", "PERCENTAGE_POINT", "RANGE"] },
        "tolerance": { "type": ["number", "null"], "minimum": 0 },
        "unit": { "type": ["string", "null"] },
        "rounding": { "type": ["integer", "null"], "minimum": 0 }
      }
    }
  }
}
