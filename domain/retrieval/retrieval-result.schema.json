{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://disclosure-analyst.local/schema/retrieval-result.v0.2.json",
  "title": "Retrieval Result v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "query_id", "retrieval_method", "corpus_snapshot_id",
    "chunking_config_id", "index_snapshot_id", "applied_filters", "top_k",
    "latency_ms", "results"
  ],
  "properties": {
    "schema_version": { "const": "0.2.0" },
    "query_id": { "type": "string", "minLength": 1 },
    "retrieval_method": { "enum": ["BM25", "DENSE", "HYBRID_RRF", "HYBRID_RRF_RERANKER"] },
    "corpus_snapshot_id": { "type": "string", "minLength": 1 },
    "chunking_config_id": { "type": "string", "minLength": 1 },
    "index_snapshot_id": { "type": "string", "minLength": 1 },
    "applied_filters": { "$ref": "#/$defs/metadataFilters" },
    "top_k": { "type": "integer", "minimum": 1 },
    "latency_ms": { "type": "number", "minimum": 0 },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rank", "score", "score_type", "component_scores", "document_id",
          "chunk_id", "chunk_type", "parent_chunk_id", "text_provenance",
          "citation_authority", "raw_text", "source_locator", "source_spans"
        ],
        "properties": {
          "rank": { "type": "integer", "minimum": 1 },
          "score": { "type": "number" },
          "score_type": { "enum": ["BM25", "COSINE", "RRF", "RERANKER"] },
          "component_scores": {
            "type": "object",
            "additionalProperties": false,
            "required": ["bm25", "dense", "rrf", "reranker"],
            "properties": {
              "bm25": { "type": ["number", "null"] },
              "dense": { "type": ["number", "null"] },
              "rrf": { "type": ["number", "null"] },
              "reranker": { "type": ["number", "null"] }
            }
          },
          "document_id": { "type": "string", "minLength": 1 },
          "chunk_id": { "type": "string", "pattern": "^chunk_[0-9a-f]{24}$" },
          "chunk_type": {
            "enum": [
              "FIXED_WINDOW", "SECTION_FLAT", "SECTION_PARENT", "EVENT_PARENT",
              "HOLDING_STATUS_PARENT", "PARAGRAPH_CHILD", "FIELD_GROUP_CHILD",
              "TABLE_WHOLE", "TABLE_ROW", "DOCUMENT_FALLBACK"
            ],
            "description": "Must equal the source Chunk's chunk_type (domain/chunking/chunk.schema.json)."
          },
          "parent_chunk_id": { "type": ["string", "null"], "pattern": "^chunk_[0-9a-f]{24}$" },
          "text_provenance": {
            "enum": ["SOURCE_VERBATIM", "DETERMINISTIC_LINEARIZATION", "STRUCTURAL_CONTEXT"],
            "description": "How raw_text relates to the original document. SOURCE_VERBATIM: raw_text is the untouched source string. DETERMINISTIC_LINEARIZATION: raw_text is a reproducible rendering of structured source data (e.g. a table row joined with separators) and is NOT a verbatim quote. STRUCTURAL_CONTEXT: raw_text includes synthesized context (titles, parent summaries) around the matched content. In every case raw_text is retrieval/HCX context, not a citation guarantee by itself — see citation_authority."
          },
          "citation_authority": {
            "const": "SOURCE_SPANS",
            "description": "The authoritative citation location is always source_spans, never raw_text. Consumers must render citations from source_spans (file_id/rel_path/node_id/row/col), regardless of text_provenance."
          },
          "raw_text": {
            "type": "string",
            "minLength": 1,
            "description": "The matched Chunk's text, unmodified, for use as retrieval/HCX context. Not guaranteed to be a direct quote of the source document unless text_provenance is SOURCE_VERBATIM."
          },
          "source_locator": { "type": "string", "minLength": 1 },
          "source_spans": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceSpan" } }
        }
      }
    }
  },
  "$defs": {
    "metadataFilters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corp_codes", "document_ids", "doc_groups", "doc_subtypes", "base_years",
        "base_months", "receipt_date_from", "receipt_date_to", "is_correction",
        "retrieval_eligible"
      ],
      "properties": {
        "corp_codes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[0-9]{8}$" } },
        "document_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "doc_groups": { "type": "array", "uniqueItems": true, "items": { "enum": ["periodic", "major", "exchange", "holding"] } },
        "doc_subtypes": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "base_years": { "type": "array", "uniqueItems": true, "items": { "type": "integer" } },
        "base_months": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1, "maximum": 12 } },
        "receipt_date_from": { "type": ["string", "null"], "format": "date" },
        "receipt_date_to": { "type": ["string", "null"], "format": "date" },
        "is_correction": { "type": ["boolean", "null"] },
        "retrieval_eligible": { "const": true }
      }
    },
    "sourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_id", "rel_path", "node_id", "order_index", "row_start", "row_end",
        "col_start", "col_end", "source_locator"
      ],
      "properties": {
        "file_id": { "type": "string", "pattern": "^file_[0-9a-f]{24}$" },
        "rel_path": { "type": "string", "minLength": 1 },
        "node_id": { "type": "string", "minLength": 1 },
        "order_index": { "type": "integer", "minimum": 0 },
        "row_start": { "type": ["integer", "null"], "minimum": 0 },
        "row_end": { "type": ["integer", "null"], "minimum": 0 },
        "col_start": { "type": ["integer", "null"], "minimum": 0 },
        "col_end": { "type": ["integer", "null"], "minimum": 0 },
        "source_locator": { "type": "string", "minLength": 1 }
      }
    }
  }
}
