{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://disclosure-analyst.local/schema/index-snapshot-manifest.v0.1.json",
  "title": "Retrieval Index Snapshot Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "index_snapshot_id", "corpus_snapshot_id",
    "chunking_config_id", "created_at", "components", "hybrid_combination"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "index_snapshot_id": { "type": "string", "minLength": 1 },
    "corpus_snapshot_id": { "type": "string", "minLength": 1 },
    "chunking_config_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/component" }
    },
    "hybrid_combination": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["method", "rrf_k"],
      "properties": {
        "method": { "const": "RRF" },
        "rrf_k": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_role", "backend", "backend_version", "index_hash",
        "embedding_model_id", "embedding_dimension", "normalization"
      ],
      "properties": {
        "component_role": { "enum": ["LEXICAL", "DENSE", "RERANKER"] },
        "backend": { "type": "string", "minLength": 1 },
        "backend_version": { "type": "string", "minLength": 1 },
        "index_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "embedding_model_id": { "type": ["string", "null"] },
        "embedding_dimension": { "type": ["integer", "null"], "minimum": 1 },
        "normalization": { "enum": ["NONE", "L2", "COSINE", null] }
      }
    }
  }
}
