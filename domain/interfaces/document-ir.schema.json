{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://disclosure-analyst.local/schema/document-ir.v0.1.json",
  "title": "A to B DocumentIR",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_snapshot_id",
    "document_id",
    "parser",
    "files",
    "blocks"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "corpus_snapshot_id": { "type": "string", "minLength": 1 },
    "document_id": { "type": "string", "pattern": "^(periodic|major|exchange|holding)_[0-9]{14}$" },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "completed_at"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "completed_at": { "type": "string", "format": "date-time" }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file_id",
          "relative_path",
          "file_role",
          "detected_format",
          "detected_encoding",
          "parse_status",
          "repair_used",
          "text_loss_suspected",
          "content_sha256"
        ],
        "properties": {
          "file_id": { "type": "string", "pattern": "^file_[0-9a-f]{24}$" },
          "relative_path": { "type": "string", "minLength": 1 },
          "file_role": { "enum": ["MAIN", "AUDIT", "CONSOLIDATED_AUDIT", "VIEWER_HTML", "PDF_FALLBACK", "OTHER"] },
          "detected_format": { "enum": ["XML", "HTML", "PDF", "UNKNOWN"] },
          "declared_encoding": { "type": ["string", "null"] },
          "detected_encoding": { "type": ["string", "null"] },
          "parse_status": { "enum": ["SUCCESS", "PARTIAL", "FAILED"] },
          "repair_used": { "type": "boolean" },
          "text_loss_suspected": { "type": "boolean" },
          "warning_codes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["block_id", "file_id", "block_type", "ordinal", "section_path", "source_locator"],
        "properties": {
          "block_id": { "type": "string", "minLength": 1 },
          "file_id": { "type": "string", "pattern": "^file_[0-9a-f]{24}$" },
          "parent_block_id": { "type": ["string", "null"] },
          "block_type": { "enum": ["TITLE", "PARAGRAPH", "TABLE", "TABLE_ROW", "FIELD_GROUP", "PAGE_BREAK", "OTHER"] },
          "ordinal": { "type": "integer", "minimum": 0 },
          "section_path": { "type": "array", "items": { "type": "string" } },
          "source_locator": { "type": "string", "minLength": 1 },
          "text": { "type": ["string", "null"] },
          "table": {
            "type": ["object", "null"],
            "properties": {
              "caption": { "type": ["string", "null"] },
              "header_rows": { "type": "array" },
              "body_rows": { "type": "array" },
              "unit_text": { "type": ["string", "null"] }
            },
            "required": ["header_rows", "body_rows"],
            "additionalProperties": true
          },
          "metadata": { "type": "object" }
        }
      }
    },
    "quality_summary": {
      "type": "object",
      "properties": {
        "extracted_char_count": { "type": "integer", "minimum": 0 },
        "table_count": { "type": "integer", "minimum": 0 },
        "required_section_coverage": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": true
    }
  }
}
