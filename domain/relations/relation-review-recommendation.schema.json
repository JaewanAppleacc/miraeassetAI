{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://disclosure-analyst.local/schema/relation-review-recommendation.v0.1.json",
  "title": "Relation Review Recommendation v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "review_packet_id", "corpus_snapshot_id", "relation_candidate_id",
    "relation_type", "source_document", "source_parse", "recommended_target_document",
    "candidate_count", "candidate_summaries", "evidence", "recommendation_basis",
    "machine_status", "human_action", "review_status", "review"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "review_packet_id": { "type": "string", "pattern": "^relation_review_[0-9a-f]{24}$" },
    "corpus_snapshot_id": { "type": "string", "minLength": 1 },
    "relation_candidate_id": { "type": "string", "minLength": 1 },
    "relation_type": { "enum": ["AMENDS", "TERMINATES"] },
    "source_document": { "$ref": "#/$defs/documentRef" },
    "source_parse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason_code", "warning_codes"],
      "properties": {
        "state": { "enum": ["PRESENT", "PARTIAL_PARSE_FAILURE", "PARSE_FAILED"] },
        "reason_code": { "type": "string", "minLength": 1 },
        "warning_codes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "recommended_target_document": {
      "oneOf": [{ "$ref": "#/$defs/documentRef" }, { "type": "null" }]
    },
    "candidate_count": { "type": "integer", "minimum": 0 },
    "candidate_summaries": {
      "type": "array",
      "maxItems": 5,
      "items": { "$ref": "#/$defs/candidateSummary" }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceRef" }
    },
    "recommendation_basis": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "EXPLICIT_REFERENCE_UNIQUE_MATCH", "EXPLICIT_REFERENCE_AMBIGUOUS",
          "EXPLICIT_REFERENCE_TARGET_OUTSIDE_CORPUS", "MANIFEST_CANDIDATES_ONLY",
          "PARSE_NOT_FULLY_USABLE", "FACT_IDENTITY_HIGH_CONFIDENCE",
          "FACT_IDENTITY_AMBIGUOUS", "NO_PRIOR_MANIFEST_CANDIDATE",
          "EXPLICIT_TERMINATION_WORDING", "TARGET_AMENDS_REVIEW_PENDING"
        ]
      }
    },
    "machine_status": {
      "enum": [
        "READY_FOR_HUMAN_REVIEW", "AMBIGUOUS_REVIEW",
        "TARGET_OUTSIDE_CORPUS_REVIEW", "NO_TARGET_CANDIDATE_REVIEW",
        "PARSE_BLOCKED", "BLOCKED_UNTIL_TARGET_AMENDS_REVIEW"
      ]
    },
    "human_action": { "type": "string", "minLength": 1 },
    "review_status": { "const": "PENDING_HUMAN_REVIEW" },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "reviewed_at", "outcome", "target_document_id", "evidence_ids", "notes"],
      "properties": {
        "reviewer_id": { "type": "null" },
        "reviewed_at": { "type": "null" },
        "outcome": { "type": "null" },
        "target_document_id": { "type": "null" },
        "evidence_ids": { "type": "array", "maxItems": 0 },
        "notes": { "type": "null" }
      }
    }
  },
  "$defs": {
    "documentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "corp_code", "doc_group", "report_name", "receipt_date", "is_correction"],
      "properties": {
        "document_id": { "type": "string", "minLength": 1 },
        "corp_code": { "type": "string", "pattern": "^[0-9]{8}$" },
        "doc_group": { "enum": ["exchange", "holding", "major", "periodic"] },
        "report_name": { "type": "string" },
        "receipt_date": { "type": "string", "format": "date" },
        "is_correction": { "type": "boolean" }
      }
    },
    "candidateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_document", "candidate_score", "identity_score", "matching_field_count",
        "contradiction_count", "reasons", "field_matches"
      ],
      "properties": {
        "target_document": { "$ref": "#/$defs/documentRef" },
        "candidate_score": { "type": "number" },
        "identity_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "matching_field_count": { "type": ["integer", "null"], "minimum": 0 },
        "contradiction_count": { "type": ["integer", "null"], "minimum": 0 },
        "reasons": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "field_matches": {
          "type": "object",
          "additionalProperties": { "type": ["boolean", "null"] }
        }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "kind", "document_id", "source_locator", "quoted_text"],
      "properties": {
        "evidence_id": { "type": "string", "pattern": "^review_evidence_[0-9a-f]{24}$" },
        "kind": {
          "enum": ["REFERENCE_REPORT", "REFERENCE_DATE", "CORRECTION_REASON", "TERMINATION_TEXT", "FACT_VALUE"]
        },
        "document_id": { "type": "string", "minLength": 1 },
        "source_locator": { "type": "string", "minLength": 1 },
        "quoted_text": { "type": "string", "minLength": 1 }
      }
    }
  }
}
