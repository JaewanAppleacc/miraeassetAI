{
  "name": "dart-corpus-viewer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "viewer:api": "node scripts/viewer-api.mjs",
    "viewer": "node scripts/start-viewer.mjs",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:domain": "node --test tests/domain-contracts.test.mjs tests/a-document-ir-adapter.test.mjs tests/exchange-contract-facts.test.mjs tests/chunker.test.mjs tests/relation-review-recommendations.test.mjs tests/agent-runtime.test.mjs",
    "domain:audit": "node scripts/audit-domain-data.mjs",
    "domain:seed": "node scripts/build-domain-seed.mjs",
    "domain:eval-queue": "node scripts/build-evaluation-authoring-queue.mjs",
    "domain:adapt-a": "node scripts/adapt-a-document-ir.mjs",
    "domain:register-a": "node scripts/register-a-document-ir.mjs",
    "domain:merge-a-coverage": "node scripts/merge-a-parse-coverage.mjs",
    "domain:extract-exchange-contracts": "node scripts/extract-exchange-contract-facts.mjs",
    "domain:enrich-terminations": "node scripts/enrich-termination-review-queue.mjs",
    "domain:termination-review-packets": "node scripts/build-termination-review-packets.mjs",
    "domain:relation-review-recommendations": "node scripts/build-relation-review-recommendations.mjs",
    "domain:exchange-correction-refs": "node scripts/extract-exchange-correction-references.mjs",
    "domain:merge-exchange-correction-refs": "node scripts/merge-exchange-correction-references.mjs",
    "domain:chunk-samples": "node scripts/generate-representative-chunks.mjs",
    "domain:chunk-budget": "node scripts/profile-chunk-budget.mjs",
    "domain:chunk-budget-full": "node scripts/profile-full-corpus-chunks.mjs",
    "domain:semantic-handoff": "node scripts/build-semantic-handoff.mjs",
    "domain:ai-second-review": "node scripts/build-ai-second-review.mjs",
    "domain:validate-semantic-handoff": "node scripts/validate-semantic-handoff.mjs",
    "domain:validate-chunk-handoff": "node scripts/validate-chunk-handoff.mjs",
    "domain:validate-b": "node scripts/validate-b-artifacts.mjs",
    "schema:validate": "node scripts/validate-interface-schemas.mjs",
    "eval:validate": "node scripts/validate-evaluation.mjs",
    "typecheck": "tsc --noEmit",
    "verify:contracts": "npm run schema:validate && npm run test:domain && npm run typecheck",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
