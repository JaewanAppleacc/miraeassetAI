# 이름만 나열한다 — 실제 값 없음. .env로 복사해 환경에 맞게 채운다.

# ---------- LLM (HyperCLOVA X) ----------
CLOVA_API_KEY=
# 선택 — 비우면 기본 모델/엔드포인트를 쓴다.
CLOVA_MODEL=
CLOVA_ENDPOINT=

# ---------- 검색 백엔드 선택 ----------
# DART_QA_RETRIEVAL_BACKEND로 지정하지 않는다 — 원본 커밋 시점에 ARM_A4_A3_REMEDIATION_LIVE는
# answer_api.py의 백엔드 이름 디스패치 표에 등록되어 있지 않아, 그 env로 지정하면
# readiness()가 ready=False를 보고한다. 대신 scripts/run_server.py(README 참조)가 공개 빌더
# 함수로 이 백엔드를 직접 선택한다. 이 변수는 비워 둔다.

# ---------- 코퍼스/색인 경로 (Python 쪽) ----------
DART_QA_DOCUMENT_IR_DIR=
DART_QA_INDEX_DIR=
DART_QA_DOC_INDEX=
DART_QA_UNIVERSE=
DART_QA_ALIASES=

# ---------- ARM_A4_A3_REMEDIATION_LIVE 워커 (Node 쪽) ----------
# 전부 scripts/arm_a4_a3_remediation_live_worker.mjs 기동 시 필수.
ARM_A4_A3_REMEDIATION_LIVE_DATABASE_URL=
ARM_A4_A3_REMEDIATION_LIVE_RETRIEVAL_INDEX_ID=
ARM_A4_A3_REMEDIATION_LIVE_LOAD_SESSION_ID=
# 선택 — 비우면 ARM_A4_A3_REMEDIATION_LIVE_LOAD_SESSION_ID 값을 쓴다.
ARM_A4_A3_REMEDIATION_LIVE_PROVENANCE_LOAD_SESSION_ID=
ARM_A4_A3_REMEDIATION_LIVE_CORPUS_SNAPSHOT_ID=
ARM_A4_A3_REMEDIATION_LIVE_KURE_SERVER_URL=
ARM_A4_A3_REMEDIATION_LIVE_BM25_CACHE_DIR=

# ---------- 기타 런타임 (선택) ----------
DART_QA_DEADLINE_S=
DART_QA_CACHE_DIR=
DART_QA_CODE_SHA=
DART_QA_SEED=
DART_QA_FC_TEMPERATURE=
