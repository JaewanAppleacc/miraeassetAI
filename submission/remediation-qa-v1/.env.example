# Names only -- no real values. Copy to .env and fill in for your environment.

# ---------- LLM (HyperCLOVA X) ----------
CLOVA_API_KEY=
# Optional overrides -- default model/endpoint are used if unset.
CLOVA_MODEL=
CLOVA_ENDPOINT=

# ---------- retrieval backend selection ----------
# NOT via DART_QA_RETRIEVAL_BACKEND -- at this pinned source commit,
# ARM_A4_A3_REMEDIATION_LIVE is implemented but not yet registered in answer_api.py's own
# backend-name dispatch table, so setting that env var to this name would make
# readiness() report ready=False. scripts/run_server.py (see README) selects this
# backend directly via its own public builder function instead. Leave this var unset.

# ---------- corpus / index paths (Python side) ----------
DART_QA_DOCUMENT_IR_DIR=
DART_QA_INDEX_DIR=
DART_QA_DOC_INDEX=
DART_QA_UNIVERSE=
DART_QA_ALIASES=

# ---------- ARM_A4_A3_REMEDIATION_LIVE worker (Node side) ----------
# All required by scripts/arm_a4_a3_remediation_live_worker.mjs at startup.
ARM_A4_A3_REMEDIATION_LIVE_DATABASE_URL=
ARM_A4_A3_REMEDIATION_LIVE_RETRIEVAL_INDEX_ID=
ARM_A4_A3_REMEDIATION_LIVE_LOAD_SESSION_ID=
# Optional -- defaults to ARM_A4_A3_REMEDIATION_LIVE_LOAD_SESSION_ID if unset.
ARM_A4_A3_REMEDIATION_LIVE_PROVENANCE_LOAD_SESSION_ID=
ARM_A4_A3_REMEDIATION_LIVE_CORPUS_SNAPSHOT_ID=
ARM_A4_A3_REMEDIATION_LIVE_KURE_SERVER_URL=
ARM_A4_A3_REMEDIATION_LIVE_BM25_CACHE_DIR=

# ---------- misc runtime knobs (optional) ----------
DART_QA_DEADLINE_S=
DART_QA_CACHE_DIR=
# Submission/evaluation profile used by the documented frozen QA runtime.
# When enabled, DART_QA_CODE_SHA must be non-empty so /ready can pin the code.
DART_QA_EVAL_PROFILE=1
DART_QA_CODE_SHA=b5f9443f7ca3ec2d57c2d17453070ab23c4a6341
# Keep the optional QA-side late-expansion experiment disabled. The selected
# remediation backend was validated with this variable unset/OFF.
# DART_QA_LATE_EXPANSION=1
DART_QA_SEED=
DART_QA_FC_TEMPERATURE=
