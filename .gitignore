# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.venv/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# python (task-owned venvs are never in-repo; this only catches stray
# bytecode caches from running .py scripts directly, e.g.
# scripts/embedding-calibration-real/local_embedding_server.py)
__pycache__/
*.pyc

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/
/tmp/
# Generated release bundles are machine-generated Seed data -- same
# policy as /work/ above for anything NOT explicitly deterministically
# gzip-compressed and size-bounded (CLAUDE.md: 대용량 work/, 원본 데이터...
# Git에 추가하지 않는다). Turn L2: the whole directory is no longer
# blanket-ignored -- the deterministic-gzip candidate bundle at
# seed-release-v0.20/ is deliberately small (~13MB, every single file
# under 100MiB -- see domain/adapters/seed-release-bundle-builder.mjs's
# GZIP_ROLES) and is meant to be Git-trackable so a real clone can
# reproduce a deployable bundle without needing the full work/ tree. Any
# OTHER (future) bundle directory here defaults back to ignored until it
# is explicitly negated the same way.
/domain/releases/bundles/*
!/domain/releases/bundles/seed-release-v0.20/
!/domain/releases/bundles/seed-release-v0.20-r2.candidate/
!/domain/releases/bundles/seed-release-v0.20-r3.candidate/
/.vscode/
/.claude/settings.local.json
